<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sanad_eye_tracking</name>
  <version>0.0.0</version>
  <description>Eye-tracking package for SANAD wheelchair. Uses gaze direction
  (north/south/east/west held for 3 s) to navigate a grid UI, double-blink to
  click, and eyes-closed for 3 s to go back.</description>
  <maintainer email="mohmed.ayman11@gmail.com">zero</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>

  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
