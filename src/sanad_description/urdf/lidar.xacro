<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Properties to align with mobile_base conventions -->
    <xacro:property name="lidar_offset_xyz" value="0.122 0 0.212"/>
    <xacro:property name="lidar_body_radius" value="0.05"/>
    <xacro:property name="lidar_body_length" value="0.04"/>
    <xacro:property name="lidar_stem_radius" value="0.01"/>
    <xacro:property name="lidar_stem_length" value="0.1"/>
    <xacro:property name="lidar_mass" value="0.1"/>

    <!-- Mount lidar to base_link (old models used 'chassis') -->
    <joint name="laser_joint" type="fixed">
        <parent link="base_link"/>
        <child link="laser_frame"/>
        <origin xyz="${lidar_offset_xyz}" rpy="0 0 0"/>
    </joint>

    <link name="laser_frame">
        <visual>
            <geometry>
                <cylinder radius="${lidar_body_radius}" length="${lidar_body_length}"/>
            </geometry>
            <material name="black"/>
        </visual>
        <visual>
            <origin xyz="0 0 -${lidar_stem_length/2}"/>
            <geometry>
                <cylinder radius="${lidar_stem_radius}" length="${lidar_stem_length}"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${lidar_body_radius}" length="${lidar_body_length}"/>
            </geometry>
        </collision>
        <xacro:wheel_inertia m="${lidar_mass}" r="${lidar_body_radius}" h="${lidar_body_length}" o_xyz="0 0 0" o_rpy="0 0 0" />
    </link>

    <!-- Gazebo sensor config consistent with ROS 2 bridging -->
    <gazebo reference="laser_frame">
        <material>Gazebo/Black</material>
        <sensor name="laser" type="gpu_lidar">
            <pose>0 0 0 0 0 0</pose>
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <min_angle>-3.14</min_angle>
                        <max_angle>3.14</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.3</min>
                    <max>12</max>
                </range>
            </lidar>
            <topic>scan</topic>
            <gz_frame_id>laser_frame</gz_frame_id>
        </sensor>
    </gazebo>

</robot>