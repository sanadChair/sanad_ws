<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="FollowPerson">
    <!--
      Gate: compute one valid path before entering the pipeline.
      After this succeeds once, PipelineSequence takes over:
        - RateController replans globally at 1 Hz
        - FollowPath tracks the current path at 10 ms (every tick)
      A planning failure returns FAILURE on that tick; the next tick
      retries immediately with the latest goal — no recovery lockout.
    -->
    <Sequence>
      <ComputePathToPose goal="{goal}" planner_id="GridBased" path="{path}"/>
      <PipelineSequence>
        <RateController hz="1.0">
          <ComputePathToPose goal="{goal}" planner_id="GridBased" path="{path}"/>
        </RateController>
        <FollowPath controller_id="FollowPath" path="{path}"/>
      </PipelineSequence>
    </Sequence>
  </BehaviorTree>
</root>