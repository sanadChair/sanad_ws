<launch>
  <let name="urdf_path"
        value="$(find-pkg-share sanad_description)/urdf/sanad.urdf.xacro" />
  <let name="rviz_config_path"
        value="$(find-pkg-share sanad_description)/rviz/config.rviz" />

    <node pkg="robot_state_publisher" exec="robot_state_publisher">
      <param name="robot_description" value="$(command 'xacro $(var urdf_path)')" />
    </node>

    <node pkg="joint_state_publisher_gui" exec="joint_state_publisher_gui" />

  <node pkg="ros_gz_bridge" exec="parameter_bridge" output="screen">
    <param name="topics" value="/lidar/scan@sensor_msgs/msg/LaserScan[ignition.msgs.LaserScan]"/>
  </node>

    <node pkg="rviz2" exec="rviz2" output="screen" args="-d $(var rviz_config_path)" />
</launch>